NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/careerhub
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
AUTO_BACKUP_INTERVAL_HOURS=12

# Optional Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP Configuration (for sending OTPs via Nodemailer to real inbox)
# Option A: Gmail (Use a Google App Password from myaccount.google.com/apppasswords)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="CareerHub Security" <your_email@gmail.com>

# Option B: Custom SMTP Server
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
